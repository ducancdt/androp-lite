# Sao chép thành .env rồi điền khóa. Chỉ cần MỘT nhà cung cấp dịch.

# --- Gemini (mặc định) : https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Bất kỳ API tương thích OpenAI: OpenAI, Groq, OpenRouter, DeepSeek, Ollama, LM Studio... ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Tuỳ chọn chung ---
# LT_TARGET_LANG=vi
# LT_VOICE=Mai Anh
